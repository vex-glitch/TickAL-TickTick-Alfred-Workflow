{
  "_readme": "TickAL routine step lists (see src/routine_runner.py for the step types). Ported from Vex's Keyboard Maestro macros 2026-09-12, frames unchanged. {tid}/{pid} expand to the routine's own task.",
  "startup": {
    "name": "🌅 Startup",
    "steps": [
      {"do": "activate", "app": "com.TickTick.task.mac", "wait": true},
      {"do": "hide_others"},
      {"do": "place", "app": "com.TickTick.task.mac", "frame": [970, 10, 1900, 1060]},
      {"do": "activate", "app": "com.apple.Safari.WebApp.33619214-A054-4466-9B40-FF08655838E4", "wait": true},
      {"do": "place", "app": "com.apple.Safari.WebApp.33619214-A054-4466-9B40-FF08655838E4", "frame": [1606, -848, 1004, 838]},
      {"do": "activate", "app": "com.TickTick.task.mac", "wait": true},
      {"do": "link", "arg": "focus:{tid}:{pid}", "sticky": [2887, 355, 490, 705], "bar": [2888, 10]},
      {"do": "link", "arg": "notesticky:daily", "sticky": [3850, -845, 1060, 1900]},
      {"do": "link", "arg": "view:calendar"},
      {"do": "activate", "app": "com.TickTick.task.mac"},
      {"do": "key", "key": "escape", "mods": ["shift"]}
    ]
  },
  "shutdown": {
    "name": "🌆 Shutdown",
