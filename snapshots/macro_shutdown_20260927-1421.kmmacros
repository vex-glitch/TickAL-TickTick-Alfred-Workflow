			<string>Nothing</string>
			<key>Text</key>
			<string>bid="com.TickTick.task.mac"; name="TickTick"
pgrep -x "$name" &gt;/dev/null || exit 0
osascript -e 'on run argv' -e 'with timeout of 15 seconds' -e 'tell application id (item 1 of argv) to quit' -e 'end timeout' -e 'end run' "$bid" &gt;/dev/null 2&gt;&amp;1
for i in $(seq 1 75); do pgrep -x "$name" &gt;/dev/null || exit 0; sleep 0.2; done
echo "$name did not quit in 15 s"</string>
