			<key>ActionName</key>
			<string>Restart TickTick (quit)</string>
			<key>ActionUID</key>
			<integer>17159781</integer>
			<key>DisplayKind</key>
			<string>Briefly</string>
			<key>HonourFailureSettings</key>
