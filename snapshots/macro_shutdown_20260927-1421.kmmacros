			<key>Source</key>
			<string>Nothing</string>
			<key>Text</key>
			<string>osascript - "com.TickTick.task.mac" 1089 -856 2037 848 &lt;&lt;'OSA'
on run argv
	set bid to item 1 of argv
	set nx to (item 2 of argv) as integer
	set ny to (item 3 of argv) as integer
	set nw to (item 4 of argv) as integer
	set nh to (item 5 of argv) as integer
	tell application "System Events"
		repeat 75 times
			try
				tell (first process whose bundle identifier is bid)
					if exists (first window whose subrole is "AXStandardWindow") then
						set position of (first window whose subrole is "AXStandardWindow") to {nx, ny}
						set size of (first window whose subrole is "AXStandardWindow") to {nw, nh}
						return "placed"
					end if
				end tell
			end try
			delay 0.2
		end repeat
	end tell
	return "no window to place"
end run
OSA</string>
